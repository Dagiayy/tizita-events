{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApiAndWorkerObjectAccess",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": [
        "arn:aws:s3:::event-quarantine/*",
        "arn:aws:s3:::event-media/*",
        "arn:aws:s3:::event-exports/*"
      ]
    },
    {
      "Sid": "ListBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": [
        "arn:aws:s3:::event-quarantine",
        "arn:aws:s3:::event-media",
        "arn:aws:s3:::event-exports"
      ]
    }
  ]
}
