# Production-style environment for the Docker Compose stack (infra/docker-compose.yml, profile "app").
# Generate real secrets:   ./infra/scripts/gen-secrets.sh > .env     then review every line marked CHANGE.
# Contains NO real secrets - @PLACEHOLDERS@ are filled in by gen-secrets.sh. Never commit the generated .env.
APP_ENV=production
PUBLIC_WEB_URL=https://photos.example.et          # CHANGE: your Ethiopia-hosted domain (https required)
PUBLIC_API_URL=https://photos.example.et          # same origin when nginx fronts web + api
CORS_ORIGINS=https://photos.example.et            # CHANGE
PAYMENT_CALLBACK_BASE_URL=https://photos.example.et
DATABASE_SSL=false                                # true if Postgres is not the compose container
DATABASE_POOL_MAX=20

# Compose service names are explicitly allowed for the data-residency check; add your own hosts/suffixes if you use external ones.
DATA_RESIDENCY_ALLOWED_HOST_SUFFIXES=localhost,postgres,redis,minio,clamav,.internal,.et

POSTGRES_USER=event
POSTGRES_PASSWORD=@POSTGRES_PASSWORD@
POSTGRES_DB=event
MINIO_ROOT_USER=@MINIO_ROOT_USER@
MINIO_ROOT_PASSWORD=@MINIO_ROOT_PASSWORD@
# API/worker object-store credentials (production: create a dedicated MinIO account from infra/minio/policies instead of root)
S3_ACCESS_KEY=@MINIO_ROOT_USER@
S3_SECRET_KEY=@MINIO_ROOT_PASSWORD@
S3_REGION=et-addis-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET_QUARANTINE=event-quarantine
S3_BUCKET_MEDIA=event-media
S3_BUCKET_EXPORTS=event-exports
S3_SSE=false                                      # true once MinIO KMS/KES is configured

JWT_ACCESS_SECRET=@JWT_ACCESS_SECRET@
JWT_GUEST_SECRET=@JWT_GUEST_SECRET@
URL_SIGNING_SECRET=@URL_SIGNING_SECRET@
HASH_PEPPER=@HASH_PEPPER@
DATA_ENCRYPTION_KEY=@DATA_ENCRYPTION_KEY@
METRICS_TOKEN=@METRICS_TOKEN@
GRAFANA_ADMIN_PASSWORD=@GRAFANA_ADMIN_PASSWORD@

AV_MODE=clamd                                     # required in production; start with  --profile av
CLAMD_PORT=3310
OTP_FIXED_CODE=
SMS_PROVIDERS=primary,fallback                    # CHANGE: real providers; console/memory are refused in production
SMS_HTTP_PRIMARY_URL=
SMS_HTTP_PRIMARY_API_KEY=
SMS_HTTP_PRIMARY_SENDER_ID=
SMS_HTTP_FALLBACK_URL=
SMS_HTTP_FALLBACK_API_KEY=
SMS_HTTP_FALLBACK_SENDER_ID=
PAYMENT_PROVIDER=chapa                            # chapa | telebirr (sandbox is refused in production)
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
TRUST_PROXY=true

# Backup container (profile "ops")
BACKUP_PASSPHRASE=@BACKUP_PASSPHRASE@
BACKUP_LOCATION_LABEL=primary-site                # CHANGE: e.g. addis-dc1
BACKUP_RETENTION_DAYS=35
