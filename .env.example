# =====================================================================
# Ethiopia Event Photo Sharing Platform - environment template
# Copy to .env and fill in. NEVER commit real secrets.
# In production every value marked (REQUIRED-PROD) must come from the
# Ethiopia-hosted secret store / encrypted environment store.
# =====================================================================

# ---- Runtime --------------------------------------------------------
NODE_ENV=development            # development | test | production
# Which responsibilities this process runs: api | worker | all
APP_ROLE=all
PORT=4000
# Public URLs (used to build QR/share links, signed URLs and CORS)
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false               # true behind nginx/traefik so client IPs are honoured

# ---- Data residency (spec 9.4 / PDPP Art. 22) ----------------------
# Documented, enforced at boot in production: every endpoint below must be
# an Ethiopia-hosted host. List allowed hostname suffixes (comma separated).
DATA_RESIDENCY_ALLOWED_HOST_SUFFIXES=localhost,127.0.0.1,.internal,.et

# ---- PostgreSQL -----------------------------------------------------
DATABASE_URL=postgres://event:event_dev_password@localhost:5433/event
DATABASE_POOL_MAX=20
DATABASE_SSL=false              # true in production when DB is on another host

# ---- Redis (queues, rate limits, sessions cache, realtime fan-out) --
REDIS_URL=redis://localhost:6380/0

# ---- Object storage (Ethiopia-hosted S3-compatible, e.g. MinIO) ----
S3_ENDPOINT=http://localhost:9100
S3_REGION=et-addis-1
S3_ACCESS_KEY=minio_dev_access
S3_SECRET_KEY=minio_dev_secret_change_me
S3_FORCE_PATH_STYLE=true
S3_BUCKET_QUARANTINE=event-quarantine
S3_BUCKET_MEDIA=event-media
S3_BUCKET_EXPORTS=event-exports
# Server-side encryption flag passed to the store (SSE-S3). Volumes must also be encrypted.
S3_SSE=false

# ---- Secrets (generate each with: openssl rand -base64 48) ----------
# (REQUIRED-PROD) JWT signing for host/admin access tokens
JWT_ACCESS_SECRET=dev_only_access_secret_change_me_0123456789abcdef
# (REQUIRED-PROD) HMAC key for guest session tokens
JWT_GUEST_SECRET=dev_only_guest_secret_change_me_0123456789abcdef
# (REQUIRED-PROD) HMAC key for signed media / upload / export URLs
URL_SIGNING_SECRET=dev_only_url_signing_secret_change_me_0123456789
# (REQUIRED-PROD) Blind-index pepper for phone numbers / IP hashes
HASH_PEPPER=dev_only_hash_pepper_change_me_0123456789abcdef
# (REQUIRED-PROD) 32-byte key, base64, AES-256-GCM for phone numbers, TOTP secrets, share tokens at rest
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# ---- Token lifetimes ------------------------------------------------
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
GUEST_TOKEN_TTL_SEC=43200
GUEST_SESSION_MAX_AGE_SEC=604800
SIGNED_URL_TTL_SEC=1800
UPLOAD_TOKEN_TTL_SEC=3600
EXPORT_LINK_TTL_SEC=900

# ---- OTP / SMS -------------------------------------------------------
OTP_TTL_SEC=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
# DEV/TEST ONLY - refused when NODE_ENV=production
OTP_FIXED_CODE=
# Staff authenticator-app 2FA. Only ever set false for local development; production boot fails unless true.
ADMIN_MFA_REQUIRED=true
# Provider chain (primary then fallback). Names: console | memory | http
SMS_PROVIDERS=console
# Generic local-aggregator provider(s). Repeat with SMS_HTTP_<NAME>_* for each name in SMS_PROVIDERS.
SMS_HTTP_PRIMARY_URL=
SMS_HTTP_PRIMARY_API_KEY=
SMS_HTTP_PRIMARY_SENDER_ID=
SMS_HTTP_FALLBACK_URL=
SMS_HTTP_FALLBACK_API_KEY=
SMS_HTTP_FALLBACK_SENDER_ID=
# Guests may verify non-Ethiopian numbers (diaspora, D17). Delivery depends on the local route.
GUEST_PHONE_ALLOW_FOREIGN=false

# ---- Payments (ETB only) -------------------------------------------
# sandbox (non-production only) | chapa | telebirr
PAYMENT_PROVIDER=sandbox
PAYMENT_CALLBACK_BASE_URL=http://localhost:4000
# Chapa (licensed Ethiopian gateway; document the data flow in the vendor register)
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.co/v1
# Sandbox provider shared secret (signs simulated callbacks)
SANDBOX_PAYMENT_SECRET=dev_only_sandbox_payment_secret
# Direct telebirr (design-ready; not enabled until onboarding completes)
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_BASE_URL=

# ---- Antivirus -------------------------------------------------------
# clamd | eicar (dev/test only; refused in production)
AV_MODE=eicar
CLAMD_HOST=localhost
CLAMD_PORT=3310

# ---- Media policy (spec 8.2) - all overridable via system_settings -
MEDIA_MAX_BYTES=15728640
MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/heic,image/heif
MEDIA_MAX_PIXELS=60000000
MEDIA_CHUNK_BYTES=1048576
DERIV_THUMB_PX=480
DERIV_GALLERY_PX=1280
DERIV_VIEWER_PX=2560
DERIV_JPEG_QUALITY=85
CAPTION_MAX_CHARS=300

# ---- Abuse controls --------------------------------------------------
RATE_LIMIT_OTP_PER_PHONE=3          # requests per 10 minutes
RATE_LIMIT_OTP_PER_IP=20            # requests per hour
RATE_LIMIT_OTP_VERIFY_PER_PHONE=10  # attempts per 15 minutes
RATE_LIMIT_JOIN_PER_IP=60           # per 10 minutes
RATE_LIMIT_UPLOAD_INTENT_PER_SESSION=30   # per minute
RATE_LIMIT_REPORT_PER_SESSION=10          # per hour
GUEST_MAX_UPLOADS_PER_SESSION=100

# ---- Lifecycle / retention (spec D31/D32 - legal validation pending) -
RETENTION_DEFAULT_DAYS=180          # days after closure (standard plan)
READONLY_TO_ARCHIVE_DAYS=30
DELETION_GRACE_DAYS=14              # allowed 7-30
CLOSING_MAX_MINUTES=30
BACKUP_RETENTION_DAYS=35            # backups expire so deleted media does not persist forever
LIFECYCLE_TICK_SEC=30

# ---- Feature flags (deferred features stay OFF in MVP) --------------
FEATURE_COMMENTS=false
FEATURE_REACTIONS=false
FEATURE_VIDEO=false
FEATURE_GEO_RESTRICTION=false

# ---- Observability ---------------------------------------------------
METRICS_TOKEN=dev_only_metrics_token
LOG_LEVEL=info

# ---- Docker compose helper vars -------------------------------------
POSTGRES_USER=event
POSTGRES_PASSWORD=event_dev_password
POSTGRES_DB=event
MINIO_ROOT_USER=minio_dev_access
MINIO_ROOT_PASSWORD=minio_dev_secret_change_me
GRAFANA_ADMIN_PASSWORD=change_me
