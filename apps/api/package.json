{
  "name": "@event/api",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Ethiopia Event Photo Sharing Platform - API and workers (NestJS)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "migrate": "ts-node --transpile-only scripts/migrate.ts up",
    "migrate:status": "ts-node --transpile-only scripts/migrate.ts status",
    "migrate:prod": "node dist/scripts/migrate.js up",
    "seed": "ts-node --transpile-only scripts/seed.ts",
    "docs:routes": "ts-node --transpile-only scripts/gen-api-docs.ts",
    "admin:bootstrap": "ts-node --transpile-only scripts/bootstrap-admin.ts",
    "test": "jest --selectProjects unit",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:security": "jest --selectProjects integration --runInBand --testPathPattern security",
    "test:media": "jest --selectProjects unit integration --runInBand --testPathPattern media",
    "test:payments": "jest --selectProjects integration --runInBand --testPathPattern payments",
    "test:all": "jest --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@fontsource/noto-sans": "^5.1.0",
    "@fontsource/noto-sans-ethiopic": "^5.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "archiver": "^7.0.1",
    "bullmq": "^5.30.0",
    "exif-reader": "^2.0.1",
    "heic-convert": "^2.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/pdfkit": "^0.13.7",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "adm-zip": "^0.6.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
